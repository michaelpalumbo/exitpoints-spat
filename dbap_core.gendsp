            {
                "box": {
                    "code": "// dbap_core.genexpr\n// DBAP panner: 24 input points -> 6 speakers. Used by dbap_core.gendsp.\n//\n// in 1-24   : USB channels 1-24 from the console (point n = console channel n)\n// out 1-6   : speaker feeds\n//\n// Point and speaker data come from two buffer~s, written by dbap_control.js:\n//   buffer~ dbap_pts 1 5   (24 frames x 5 ch: x, y, level, slew ms, blur m)\n//   buffer~ dbap_spk 1 4   (frames 0-5: x, y, delay ms, gain per speaker;\n//                           frame 6, channel 1: how many speakers, 1-6)\n//\n// Outputs follow the room file's speaker order (quad: 1 FL, 2 FR, 3 BL, 4 BR).\n// Each has a delay and gain trim for calibration (from dbap_control.js).\n// With 4 speakers or fewer, outputs 5 and 6 carry the headphone monitor: every\n// point at its level, before panning, so the balance doesn't depend on where\n// the units are or where you sit.\n//\n// Coordinates in metres, origin = centre of the rectangle,\n// +y toward the stage, +x to the right when facing the stage.\n//\n// CPU: target gains are recalculated every `block` samples (default 32,\n// ~0.7 ms at 48k). Send \"block 1\" to the gen~ for sample-accurate updates.\n// Smoothing and mixing always run per sample. Points with level 0 whose\n// gains have fully faded are skipped entirely.\n\nBuffer pts(\"dbap_pts\");\nBuffer spk(\"dbap_spk\");\n\nData ins(24);\nData st(24, 6);     // smoothed gain per point per speaker\nData tg(24, 6);     // target gain per point per speaker\nData cf(24);        // smoothing coefficient per point\nData act(24);       // 1 = point needs processing\nData vt(6);         // scratch\nData acc(6);        // speaker accumulators\nData mlv(24);       // smoothed point levels for the monitor\n\nParam rolloff(6, min=0.1);   // dB per doubling of distance\nParam block(32, min=1, max=4096);   // samples between gain recalculations\nParam mongain(0.5, min=0, max=2);    // headphone monitor level\n\nHistory ctr(0);\n\n// calibration delays, up to 9600 samples (200 ms at 48k)\nDelay dl1(9600);\nDelay dl2(9600);\nDelay dl3(9600);\nDelay dl4(9600);\nDelay dl5(9600);\nDelay dl6(9600);\n\npoke(ins, in1, 0);\npoke(ins, in2, 1);\npoke(ins, in3, 2);\npoke(ins, in4, 3);\npoke(ins, in5, 4);\npoke(ins, in6, 5);\npoke(ins, in7, 6);\npoke(ins, in8, 7);\npoke(ins, in9, 8);\npoke(ins, in10, 9);\npoke(ins, in11, 10);\npoke(ins, in12, 11);\npoke(ins, in13, 12);\npoke(ins, in14, 13);\npoke(ins, in15, 14);\npoke(ins, in16, 15);\npoke(ins, in17, 16);\npoke(ins, in18, 17);\npoke(ins, in19, 18);\npoke(ins, in20, 19);\npoke(ins, in21, 20);\npoke(ins, in22, 21);\npoke(ins, in23, 22);\npoke(ins, in24, 23);\n\n// speaker count (frame 6 of dbap_spk); 0 or missing = 6\nnsr = peek(spk, 6, 0);\nns = nsr >= 1 ? min(floor(nsr), 6) : 6;\n\nupd = ctr <= 0;\n\nif (upd) {\n\t// d^-a with a = rolloff / 6.02, using squared distance: (d^2)^(-a/2)\n\tha = -0.5 * rolloff / 6.0206;\n\n\tfor (i = 0; i < 24; i = i + 1) {\n\t\tlvl = peek(pts, i, 2);\n\t\tsl = peek(pts, i, 3);\n\t\tpoke(cf, sl > 0 ? exp(-1000 / (sl * samplerate)) : 0, i);\n\n\t\tif (lvl > 0) {\n\t\t\tpx = peek(pts, i, 0);\n\t\t\tpy = peek(pts, i, 1);\n\t\t\tbl = max(peek(pts, i, 4), 0.001);\n\t\t\tb2 = bl * bl;\n\t\t\ttot = 0;\n\t\t\tfor (s = 0; s < ns; s = s + 1) {\n\t\t\t\tdx = px - peek(spk, s, 0);\n\t\t\t\tdy = py - peek(spk, s, 1);\n\t\t\t\t// a speaker with a gain trim of 0 is unused (dbap_control.js marks them so)\n\t\t\t\tv = peek(spk, s, 3) > 0 ? pow(dx * dx + dy * dy + b2, ha) : 0;\n\t\t\t\tpoke(vt, v, s);\n\t\t\t\ttot = tot + v * v;\n\t\t\t}\n\t\t\t// constant power: squared gains sum to 1, then scaled by level\n\t\t\tk = tot > 0 ? lvl / sqrt(tot) : 0;\n\t\t\tfor (s = 0; s < 6; s = s + 1) {\n\t\t\t\tpoke(tg, s < ns ? peek(vt, s) * k : 0, i, s);\n\t\t\t}\n\t\t\tpoke(act, 1, i);\n\t\t} else {\n\t\t\tm = 0;\n\t\t\tfor (s = 0; s < 6; s = s + 1) {\n\t\t\t\tpoke(tg, 0, i, s);\n\t\t\t\tm = max(m, peek(st, i, s));\n\t\t\t}\n\t\t\tif (m < 0.000001) {\n\t\t\t\tfor (s = 0; s < 6; s = s + 1) {\n\t\t\t\t\tpoke(st, 0, i, s);\n\t\t\t\t}\n\t\t\t\tpoke(act, 0, i);\n\t\t\t} else {\n\t\t\t\tpoke(act, 1, i);\n\t\t\t}\n\t\t}\n\t}\n}\n\n// clamp so a smaller block size takes effect immediately\nbs = floor(block);\nctr = upd ? bs - 1 : min(ctr - 1, bs - 1);\n\nfor (s = 0; s < 6; s = s + 1) {\n\tpoke(acc, 0, s);\n}\nmon = 0;\nmc = exp(-1000 / (20 * samplerate));   // 20 ms level smoothing for the monitor\n\nfor (i = 0; i < 24; i = i + 1) {\n\tif (peek(act, i) > 0) {\n\t\tsig = peek(ins, i);\n\t\tcoef = peek(cf, i);\n\t\tml = mix(peek(pts, i, 2), peek(mlv, i), mc);\n\t\tpoke(mlv, ml, i);\n\t\tmon = mon + sig * ml;\n\t\tfor (s = 0; s < 6; s = s + 1) {\n\t\t\tg = mix(peek(tg, i, s), peek(st, i, s), coef);\n\t\t\tpoke(st, g, i, s);\n\t\t\tpoke(acc, peek(acc, s) + sig * g, s);\n\t\t}\n\t}\n}\n\n// calibration: per-speaker delay and gain trim\nmsr = samplerate * 0.001;\n\ndl1.write(peek(acc, 0));\ndl2.write(peek(acc, 1));\ndl3.write(peek(acc, 2));\ndl4.write(peek(acc, 3));\ndl5.write(peek(acc, 4));\ndl6.write(peek(acc, 5));\n\nout1 = dl1.read(peek(spk, 0, 2) * msr) * peek(spk, 0, 3);\nout2 = dl2.read(peek(spk, 1, 2) * msr) * peek(spk, 1, 3);\nout3 = dl3.read(peek(spk, 2, 2) * msr) * peek(spk, 2, 3);\nout4 = dl4.read(peek(spk, 3, 2) * msr) * peek(spk, 3, 3);\nsp5 = dl5.read(peek(spk, 4, 2) * msr) * peek(spk, 4, 3);\nsp6 = dl6.read(peek(spk, 5, 2) * msr) * peek(spk, 5, 3);\nmo = mon * mongain;\nout5 = ns > 4 ? sp5 : mo;\nout6 = ns > 5 ? sp6 : mo;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-code",
                    "maxclass": "codebox",
                    "numinlets": 24,
                    "numoutlets": 6,
                    "outlettype": [ "", "", "", "", "", "" ],
                    "patching_rect": [ 40.0, 120.0, 1400.0, 700.0 ]
                }
